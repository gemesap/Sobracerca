  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
